	<dataset name="tableDataset" uuid="f13e6d36-5148-4ecc-bbe3-3035def80980">
		<query language="sql"><![CDATA[]]></query>
	</dataset>
	<parameter name="nip" class="java.lang.String"/>
	<parameter name="order_id" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT 
    o.order_id,
    o.order_date,
    GROUP_CONCAT(CONCAT(f.flower_name, ' (x', od.quantity, ')') SEPARATOR ', ') AS ordered_flowers,
    ROUND(o.total_amount / 1.23, 2) AS net_amount,
    ROUND(o.total_amount - (o.total_amount / 1.23), 2) AS vat_amount,
    o.total_amount AS gross_amount,
    fm.name AS customer_name,
    fm.NIP AS customer_nip,
    c.address AS customer_address,
    c.customer_contact AS customer_contact,
    pt.payment_name AS payment_type,
    e.name AS employee_name
FROM 
    orders o
LEFT JOIN 
    orderflower od ON o.order_id = od.order_id
LEFT JOIN 
    flower f ON od.flower_id = f.flower_id
LEFT JOIN 
    customer c ON o.customer_id = c.customer_id
LEFT JOIN 
    firm fm ON c.customer_id = fm.customer_id
LEFT JOIN 
    paymenttype pt ON o.payment_type_id = pt.payment_type_id
LEFT JOIN
	employee e ON o.employee_id = e.employee_id
WHERE fm.NIP = $P{nip} AND o.order_id = $P{order_id}
GROUP BY 
    o.order_id, o.order_date, fm.name, fm.NIP, c.address, c.customer_contact, pt.payment_name, o.total_amount
ORDER BY 
    o.order_date;
]]></query>
	<field name="order_id" class="java.lang.Integer"/>
	<field name="ordered_flowers" class="java.lang.String"/>
	<field name="order_date" class="java.sql.Date"/>
	<field name="nip" class="java.lang.String"/>
