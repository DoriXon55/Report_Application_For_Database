<jasperReport name="Coffee_2" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ced95029-b569-4027-895c-af2843a4e088">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Florists"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<style name="Title" fontName="Times New Roman" fontSize="50.0" bold="true"/>
	<style name="SubTitle" forecolor="#736343" fontName="Arial" fontSize="18.0"/>
	<style name="Column header" forecolor="#666666" fontName="Arial" fontSize="12.0" bold="true"/>
	<style name="Detail" fontName="Arial" fontSize="12.0"/>
	<style name="Row" mode="Transparent">
		<conditionalStyle backcolor="#E6DAC3">
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="flower_name" class="java.lang.String">
		<defaultValueExpression><![CDATA["ALL"]]></defaultValueExpression>
	</parameter>
	<parameter name="customer_type" class="java.lang.String">
		<defaultValueExpression><![CDATA["ALL"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT 
    f.flower_name AS flower_name,
    CASE
        WHEN ind.customer_id IS NOT NULL THEN CONCAT(ind.individual_name, ' ', ind.surname)
        WHEN fm.customer_id IS NOT NULL THEN fm.name
        ELSE 'Unknown Customer'
    END AS customer_name,
    CASE
        WHEN ind.customer_id IS NOT NULL THEN 'Individual'
        WHEN fm.customer_id IS NOT NULL THEN 'Firm'
        ELSE 'Unknown'
    END AS customer_type,
    SUM(od.quantity) AS total_quantity
FROM 
    flower f
JOIN 
    orderflower od ON f.flower_id = od.flower_id
JOIN 
    orders o ON od.order_id = o.order_id
JOIN 
    customer c ON o.customer_id = c.customer_id
LEFT JOIN 
    individual ind ON c.customer_id = ind.customer_id
LEFT JOIN 
    firm fm ON c.customer_id = fm.customer_id
WHERE 
    ($P{flower_name} = 'ALL' OR f.flower_name = $P{flower_name})
    AND ($P{customer_type} = 'ALL' OR 
         ($P{customer_type} = 'Individual' AND ind.customer_id IS NOT NULL) OR 
         ($P{customer_type} = 'Firm' AND fm.customer_id IS NOT NULL))
GROUP BY 
    f.flower_name, customer_name, customer_type
ORDER BY 
    f.flower_name, customer_type;
]]></query>
	<field name="flower_name" class="java.lang.String"/>
	<field name="total_quantity" class="java.lang.Integer"/>
	<field name="customer_name" class="java.lang.String"/>
