	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<query language="SQL"><![CDATA[SELECT 
    o.order_id,
    GROUP_CONCAT(f.flower_name SEPARATOR ', ') AS ordered_flowers,
    o.total_amount,
    o.order_date,
    CASE 
        WHEN ind.customer_id IS NOT NULL THEN CONCAT(ind.individual_name, ' ', ind.surname, ', ', c.customer_contact, ', ', c.address)
        WHEN fm.customer_id IS NOT NULL THEN CONCAT(fm.name, ', NIP: ', fm.nip, ', ', c.customer_contact, ', ', c.address)
        ELSE 'Unknown Customer'
    END AS customer_details,
    emp.name AS employee,
    dn.firm_name AS delivery_method,
    pt.payment_name AS payment_type
FROM 
    orders o
LEFT JOIN 
    orderflower od ON o.order_id = od.order_id
LEFT JOIN 
    flower f ON od.flower_id = f.flower_id
LEFT JOIN 
    customer c ON o.customer_id = c.customer_id
LEFT JOIN 
    individual ind ON c.customer_id = ind.customer_id
LEFT JOIN 
    firm fm ON c.customer_id = fm.customer_id
LEFT JOIN 
    employee emp ON o.employee_id = emp.employee_id
LEFT JOIN 
    delivery d ON o.delivery_id = d.delivery_id
LEFT JOIN 
    deliveryname dn ON d.delivery_name_id = dn.delivery_name_id
LEFT JOIN 
    paymenttype pt ON o.payment_type_id = pt.payment_type_id
GROUP BY 
    o.order_id, o.total_amount, o.order_date, emp.name, dn.firm_name, pt.payment_name, 
    ind.individual_name, ind.surname, c.customer_contact, c.address, 
    fm.name, fm.nip
ORDER BY 
    o.order_date
]]></query>
