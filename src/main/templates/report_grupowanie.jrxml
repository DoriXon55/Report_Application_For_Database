<jasperReport name="Simple_Blue" language="java" columnCount="1" pageWidth="595" pageHeight="842" orientation="Landscape" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="41f8437e-352f-4e97-803e-0272d56db280">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Florists"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
